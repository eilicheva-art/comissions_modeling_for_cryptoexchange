        <mxCell id="ourW8dnmgphSwBJkr2RU-29" value="&lt;p style=&quot;text-indent:-18.0pt;mso-list:l0 level1 lfo1&quot; class=&quot;MsoListParagraphCxSpFirst&quot;&gt;&lt;/p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Сумма, причитающаяся пользователю в &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;destination&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt; &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;currency,&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;получается из внесенной пользователем &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;source&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt; &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;currency&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt; &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;amount&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;путем последовательной конвертации source в payment system,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;payment system в&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;base, base в exchange, exchange в &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;destination&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;/ swap currency&amp;nbsp;(+&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;swap в destination&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot; lang=&quot;EN-US&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot; lang=&quot;EN-US&quot;&gt;currency -&amp;nbsp;&lt;/span&gt;в случае свопа), а также&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;ul style=&quot;font-size: 14px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;вычета&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;&amp;nbsp;&quot;&lt;span lang=&quot;EN-US&quot;&gt;Fixed&quot; service fee (включая Payment system и Agents fee);&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;вычета&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;&amp;nbsp;s&lt;span lang=&quot;EN-US&quot;&gt;wap provider fee;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;div style=&quot;background-color: initial; text-indent: -18pt; display: inline !important;&quot;&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;корректировки на оценку &lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;AdjustmentFactor&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;вычета&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt; &lt;span lang=&quot;EN-US&quot;&gt;withdrawal fee&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-indent: -18pt;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Таким образом, курс source to destination&amp;nbsp;&lt;/span&gt;currency&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;для пользователя зависит от курсов конвертации&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;source в payment system,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;payment system в&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;base, base в exchange, exchange в&amp;nbsp;&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;destination&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;background-color: initial;&quot;&gt;currency, а также размеров комиссий и величины&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 14px; text-indent: -24px;&quot;&gt;аdjustment factor&lt;/span&gt;&lt;br&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;text-indent:-18.0pt;mso-list:l0 level1 lfo1&quot; class=&quot;MsoListParagraphCxSpFirst&quot;&gt;&lt;span style=&quot;text-indent: -18pt; background-color: initial; font-size: 12pt;&quot;&gt;&lt;/span&gt;&lt;/p&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontColor=#000000;" parent="1" vertex="1">
